#!/usr/bin/env bash
# Back up the machine-local shell secrets file to 1Password, and restore it.
#
# ~/shell_scripts/extras.sh holds company-specific tokens and is deliberately
# kept out of the dotfiles repo, so nothing else versions or backs it up.
set -euo pipefail

FILE="${SHELL_SECRETS_FILE:-$HOME/shell_scripts/extras.sh}"
ITEM="${SHELL_SECRETS_ITEM:-shell extras.sh}"
VAULT="${SHELL_SECRETS_VAULT:-Private}"

# Every op call carries --account when one is pinned; with several accounts
# configured, op refuses to guess which.
OP=(op)
[ -n "${SHELL_SECRETS_ACCOUNT:-}" ] && OP+=(--account "$SHELL_SECRETS_ACCOUNT")

die() { printf 'shell-secrets: %s\n' "$*" >&2; exit 1; }

require_op() {
  command -v op >/dev/null 2>&1 ||
    die "1Password CLI not installed — brew install 1password-cli"
  "${OP[@]}" whoami >/dev/null 2>&1 && return 0

  local accounts
  accounts="$(op account list 2>/dev/null | tail -n +2)"
  [ -n "$accounts" ] ||
    die "no 1Password accounts configured — add one in the app, or run 'op account add'"

  {
    echo "shell-secrets: 1Password CLI is not unlocked. Configured accounts:"
    printf '%s\n' "$accounts" | sed 's/^/  /'
    cat <<'HINT'

Fix one of these, then retry:
  1. In 1Password: Settings > Developer > "Integrate with 1Password CLI".
     This is a different toggle from the MCP server. Quit and reopen the app after.
  2. Or sign in without the app integration:  eval "$(op signin)"
  3. With more than one account, pin one:     export SHELL_SECRETS_ACCOUNT=<url-or-email>
HINT
  } >&2
  exit 1
}

stored_exists() { "${OP[@]}" document get "$ITEM" --vault "$VAULT" --out-file /dev/null >/dev/null 2>&1; }

# Fetches into $tmp. Callers set up the trap that removes it.
fetch() { "${OP[@]}" document get "$ITEM" --vault "$VAULT" --out-file "$1" >/dev/null; }

cmd_backup() {
  require_op
  [ -f "$FILE" ] || die "no such file: $FILE"
  if stored_exists; then
    "${OP[@]}" document edit "$ITEM" "$FILE" --vault "$VAULT" >/dev/null
    printf 'updated "%s" in %s from %s\n' "$ITEM" "$VAULT" "$FILE"
  else
    "${OP[@]}" document create "$FILE" --title "$ITEM" --vault "$VAULT" >/dev/null
    printf 'created "%s" in %s from %s\n' "$ITEM" "$VAULT" "$FILE"
  fi
}

cmd_restore() {
  require_op
  stored_exists || die "\"$ITEM\" not in vault $VAULT — run 'shell-secrets backup' first"
  local tmp; tmp="$(mktemp)"; trap 'rm -f "$tmp"' RETURN
  fetch "$tmp"
  if [ -f "$FILE" ] && ! cmp -s "$tmp" "$FILE"; then
    [ "${1:-}" = "--force" ] ||
      die "$FILE differs from the stored copy; check 'shell-secrets status', then re-run with --force"
    cp -p "$FILE" "$FILE.bak"
    printf 'kept previous file as %s.bak\n' "$FILE"
  fi
  mkdir -p "$(dirname "$FILE")"
  install -m 600 "$tmp" "$FILE"
  printf 'restored %s from "%s"\n' "$FILE" "$ITEM"
}

# Reports whether the backup is current without printing any secret values.
cmd_status() {
  require_op
  printf 'file:  %s' "$FILE"
  [ -f "$FILE" ] && printf ' (%s lines)\n' "$(wc -l < "$FILE" | tr -d ' ')" || printf ' — MISSING\n'
  if ! stored_exists; then
    printf 'stored: "%s" not found in vault %s — never backed up\n' "$ITEM" "$VAULT"
    return 1
  fi
  local tmp; tmp="$(mktemp)"; trap 'rm -f "$tmp"' RETURN
  fetch "$tmp"
  printf 'stored: "%s" in %s\n' "$ITEM" "$VAULT"
  if cmp -s "$tmp" "$FILE"; then
    printf 'state:  up to date\n'
  else
    printf 'state:  DIFFERS — run '\''shell-secrets backup'\'' to update\n'
    return 1
  fi
}

# Prints the actual contents of both copies, secret values included.
cmd_diff() {
  require_op
  stored_exists || die "\"$ITEM\" not in vault $VAULT"
  local tmp; tmp="$(mktemp)"; trap 'rm -f "$tmp"' RETURN
  fetch "$tmp"
  diff -u -L "1Password: $ITEM" "$tmp" -L "$FILE" "$FILE" || true
}

usage() {
  cat <<USAGE
usage: shell-secrets <command>

  backup            copy $FILE into 1Password (creates or updates)
  restore [--force] write the 1Password copy back to disk
  status            report whether the backup is current (prints no secrets)
  diff              show what changed (PRINTS SECRET VALUES)

Overrides: SHELL_SECRETS_FILE, SHELL_SECRETS_ITEM, SHELL_SECRETS_VAULT,
           SHELL_SECRETS_ACCOUNT
USAGE
}

case "${1:-}" in
  backup)  cmd_backup ;;
  restore) shift; cmd_restore "${1:-}" ;;
  status)  cmd_status ;;
  diff)    cmd_diff ;;
  ""|-h|--help|help) usage ;;
  *) usage >&2; die "unknown command: $1" ;;
esac
